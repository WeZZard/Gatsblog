<div class="separator-margin-box">
  <hr class="content-separator" />
</div>

<style>
  .separator-margin-box {
    @media (max-width: 960px) {
      margin-left: calc(-1 * env(safe-area-inset-right));
      margin-right: calc(-1 * env(safe-area-inset-right));
    }

    & .content-separator {
      align-items: center;
      border: 0;
      border-top: 1px solid var(--color-gray-89);
      display: flex;
      flex-direction: row;
      margin: 0;
      padding: 0;

      @media (max-width: 960px) {
        margin-left: -2.1rem;
        margin-right: -2.1rem;
      }
    }
  }
</style>
