---
import { getSiteConfig } from '../lib/config';

const { site } = getSiteConfig();
---

<div class="page-info">
  {
    site.footerMessages.map(message => (
      <div class="page-info-item">
        <span class="page-info-content" set:html={message} />
      </div>
    ))
  }
  <div class="page-info-item">
    <span class="page-info-content">
      Built with <a href="https://astro.build">Astro</a>.
    </span>
  </div>
</div>

<style>
  .page-info {
    align-items: stretch;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    padding-top: 5.5rem;
    padding-bottom: 5.5rem;

    & .page-info-item {
      align-items: baseline;
      display: flex;
      flex-direction: row;
      color: var(--color-ui-footnote);
      margin-bottom: 0.8rem;

      &:last-child {
        margin-bottom: 0;
      }

      & .page-info-content {
        display: inline;
        font-size: 1.1em;
        font-weight: 400;
        line-height: 1.18;
        margin-bottom: -0.3rem;
        margin-top: -0.2rem;
      }

      & a {
        color: var(--color-ui-footnote);
        transition: color 0.3s ease-in-out;

        &:visited {
          color: var(--color-ui-footnote);
        }

        &:hover,
        &:visited:hover {
          color: var(--color-hover);
        }
      }
    }
  }
</style>
