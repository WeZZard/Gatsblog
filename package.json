    "@playwright/test": "^1.51.0",
    "@types/js-yaml": "^4.0.9",
    "@types/pngjs": "^6.0.5",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "wrangler": "^4.0.0"
  }
