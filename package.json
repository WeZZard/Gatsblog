{
  "name": "wezzard-blog",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "description": "WeZZard's blog system",
  "author": "WeZZard <me@WeZZard.com>",
  "license": "MIT",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "wrangler dev",
    "deploy": "ASTRO_TELEMETRY_DISABLED=1 astro build && wrangler deploy",
    "test:pixel": "playwright test",
    "astro": "ASTRO_TELEMETRY_DISABLED=1 astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/mdx": "^4.2.0",
    "@astrojs/react": "^4.2.0",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.3.0",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@wezzard/wpw": "file:../gatsby-source-wpw",
    "astro": "^5.5.0",
    "js-yaml": "^4.1.0",
    "katex": "^0.16.21",
    "prismjs": "^1.29.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-live": "^4.1.8",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
